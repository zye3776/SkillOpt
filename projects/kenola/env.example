# Optional. The default backend is the installed, logged-in Claude CLI (no key needed).
# Do NOT set ANTHROPIC_API_KEY here: Sleep then adds --bare, which breaks subscription auth.
# SKILLOPT_SLEEP_CLAUDE_MODEL=opus
# To use Z.AI instead, set backend to azure_openai in project.json and sleep/config.json and add:
# ZAI_API_KEY=
# AZURE_OPENAI_AUTH_MODE=openai_compatible
# AZURE_OPENAI_ENDPOINT=https://api.z.ai/api/coding/paas/v4
# AZURE_OPENAI_API_KEY=$ZAI_API_KEY
