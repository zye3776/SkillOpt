# Copy to .env (gitignored). Loaded by `python -m skillopt_observe` before any model call.
# Variable names only; never commit real values.

# Z.AI GLM Coding Plan through Sleep's OpenAI-compatible path
# (docs.z.ai: OpenAI Chat Completions base URL for the Coding Plan)
ZAI_API_KEY=
AZURE_OPENAI_AUTH_MODE=openai_compatible
AZURE_OPENAI_ENDPOINT=https://api.z.ai/api/coding/paas/v4
AZURE_OPENAI_API_KEY=$ZAI_API_KEY
# Optional: SKILLOPT_SLEEP_COMPAT_MAX_TOKENS=8192
